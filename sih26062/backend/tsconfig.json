{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],

    "lib": ["ES2020", "DOM"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "jsx": "react-jsx",

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",

    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
